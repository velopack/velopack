{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabled": true,
  "extends": [
    "config:recommended",
    ":configMigration",
    ":pinDevDependencies",
    "abandonments:recommended",
    "security:minimumReleaseAgeNpm",
    ":maintainLockFilesWeekly",
    ":semanticCommitsDisabled"
  ],
  "labels": ["renovate"],
  "minimumReleaseAge": "14 days",
  "schedule": ["on friday before 11am"],
  "timezone": "Europe/London",
  "ignorePaths": ["**/node_modules/**", "**/bower_components/**"],
  "dependencyDashboard": true,
  "automergeType": "pr",
  "automergeStrategy": "rebase",
  "platformAutomerge": false,
  // automatically upgrade lockfiles and automerge
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  // bypass normal schedule for security vulnerability fixes
  "vulnerabilityAlerts": {
    "schedule": ["at any time"],
    "labels": ["security"],
    "prCreation": "immediate"
  },
  // versions pinned in workflow env vars, annotated with a "# renovate:" comment on the line above
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: (?<currentValue>\\S+)"
      ]
    }
  ],
  // https://docs.renovatebot.com/key-concepts/automerge
  "packageRules": [
    {
      "groupName": "rust crates",
      "matchDatasources": "crate",
      "matchFileNames": ["Cargo.toml", "src/**"]
    },
    {
      "groupName": "npm packages",
      "matchDatasources": "npm",
      "matchFileNames": ["src/**"]
    },
    {
      "groupName": "dotnet packages",
      "matchDatasources": "nuget",
      "matchFileNames": ["src/**"]
    },
    {
      // Microsoft.* / System.* first-party packages get their own group (non-test).
      // Placed after the catch-all above so it overrides the group for these packages;
      // everything else remains in "dotnet packages".
      "groupName": "dotnet microsoft packages",
      "matchDatasources": "nuget",
      "matchFileNames": ["src/**"],
      "matchPackageNames": ["/^Microsoft\\./i", "/^System\\./i"]
    },
    {
      "groupName": "dotnet test packages",
      "matchDatasources": "nuget",
      "matchFileNames": ["test/**"]
    },
    // samples
    {
      "groupName": "sample rust crates",
      "matchDatasources": "crate",
      "matchFileNames": ["samples/**"],
      "separateMajorMinor": false,
      "automerge": true
    },
    {
      "groupName": "sample dotnet packages",
      "matchDatasources": "nuget",
      "matchFileNames": ["samples/**"],
      "separateMajorMinor": false,
      "automerge": true
    },
    {
      "groupName": "sample js packages",
      "matchDatasources": "npm",
      "matchFileNames": ["samples/**"],
      "separateMajorMinor": false,
      "automerge": true
    },
    // held-back packages
    {
      "matchPackageNames": "SixLabors.ImageSharp",
      "allowedVersions": "< 3.0.0"
    },
    {
      "matchPackageNames": "@electron/fuses",
      "allowedVersions": "< 2.0.0" // @electron-forge/plugin-fuses 7.x peer-depends on @electron/fuses ^1
    },
    {
      "matchPackageNames": "typescript",
      "matchFileNames": ["samples/NodeJSElectron/**"],
      "allowedVersions": "< 7.0.0" // TS7 has no JS API yet; ts-loader, fork-ts-checker and ts-node (forge.config.ts) need it
    },
    {
      "matchPackageNames": "@types/node",
      "allowedVersions": "< 26.0.0" // keep types close to the Node version lib-nodejs targets (@tsconfig/node24)
    },
    {
      "matchPackageNames": "/^WixToolset\\./",
      "allowedVersions": "< 6.0.0" // 6.0+ requires OSMF license acceptance
    }
  ]
}
