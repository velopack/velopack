<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <SignAssembly>false</SignAssembly>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeTfmDependenciesInPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <PropertyGroup>
    <VelopackPackageId>Velopack.Build</VelopackPackageId>
    <VelopackPackageVendorLibs>true</VelopackPackageVendorLibs>
    <PackRustAssets>false</PackRustAssets>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <VelopackPackageSelfContained>false</VelopackPackageSelfContained>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\lib-csharp\Util\ProcessExtensions.Shared.cs" Link="ProcessExtensions.Shared.cs" />
    <Compile
      Include="..\Velopack.Packaging\InstallLocation.cs" Link="InstallLocation.cs" />
    <Compile
      Include="..\Velopack.Packaging\Compression\DeltaMode.cs" Link="DeltaMode.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.11.0" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.1.3" Condition="'$(TargetFramework)' == 'net472'" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="All" />
    <ProjectReference Include="..\..\lib-csharp\Velopack.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="17.14.28" PrivateAssets="All" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.IO.Redist" Version="6.1.3" Condition="'$(TargetFramework)' == 'net472'" PrivateAssets="All" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Velopack.Build.Tests" />
    <None Include="Velopack.Build.targets" Pack="true" PackagePath="build/Velopack.Build.targets" />
    <None Include="Velopack.Build.props" Pack="true" PackagePath="build/Velopack.Build.props" />
  </ItemGroup>


  <Target Name="IncludeTfmDependenciesInPackage" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath);$(ProjectDepsFilePath);$(TargetDir)$(TargetName).pdb">
        <PackagePath>build\$(TargetFramework)</PackagePath>
      </TfmSpecificPackageFile>
      <TfmSpecificPackageFile Include="@(ReferenceCopyLocalPaths)">
        <PackagePath>build\$(TargetFramework)\%(ReferenceCopyLocalPaths.DestinationSubDirectory)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>