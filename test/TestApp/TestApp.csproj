<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition=" $(NoVelopackApp) != '' ">
    <DefineConstants>NO_VELO_BUILDER</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" $(LegacyVelopackApi) != '' ">
    <DefineConstants>$(DefineConstants);LEGACY_VELOPACK_API</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition=" $(UseAsyncMain) != '' ">
    <DefineConstants>USE_ASYNC_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition=" '$(UseVelopackPkg)' == '' ">
    <ProjectReference Include="..\..\src\lib-csharp\Velopack.csproj" />
  </ItemGroup>

  <ItemGroup Condition=" '$(UseVelopackPkg)' != '' ">
    <PackageReference Include="Velopack" Version="$(UseVelopackPkg)" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage" />
  </ItemGroup>

  <PropertyGroup>
    <TestAppTestString Condition=" '$(TestAppTestString)' == '' ">Hello, World!</TestAppTestString>
  </PropertyGroup>

  <!-- The test string is compiled into the binary (so packed versions genuinely differ, keeping delta
       packages realistic) and injected via `-p:TestAppTestString=...` — tests must not mutate source
       files, or concurrent packs would race. %3B is an escaped ';' (WriteLinesToFile splits on them). -->
  <Target Name="GenerateTestConst" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_TestConstFile>$(IntermediateOutputPath)Const.g.cs</_TestConstFile>
    </PropertyGroup>
    <WriteLinesToFile
        File="$(_TestConstFile)"
        Lines="class Const { public const string TEST_STRING = &quot;$(TestAppTestString)&quot;%3B }"
        Overwrite="true"
        WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_TestConstFile)" />
      <FileWrites Include="$(_TestConstFile)" />
    </ItemGroup>
  </Target>

</Project>
